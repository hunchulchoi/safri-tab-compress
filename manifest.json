{
  "manifest_version": 3,
  "name": "Safari Tab Compress",
  "version": "1.0.0",
  "description": "Optimizes memory by automatically closing inactive tabs.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
